@model SubscriptionHub.Models.Service

@{
    ViewData["Title"] = "Service Details";
}

<style>
    body {
        background: #f7f4ff;
    }

    .details-card {
        background: white;
        border-radius: 26px;
        border: 1px solid #e6ddff;
        box-shadow: 0 12px 30px rgba(98, 80, 200, 0.12);
    }

    .info-box {
        background: #fbfaff;
        border-radius: 18px;
        padding: 20px;
        border: 1px solid #e6ddff;
    }
</style>

<div class="container py-5">
    <div class="details-card p-5">

        <div class="row align-items-center">
            <div class="col-md-8">
                <span class="badge bg-primary mb-3">
                    @Model.Category?.Name
                </span>

                <h1 class="fw-bold mb-3">@Model.Name</h1>

                <p class="text-muted fs-5">
                    @Model.Description
                </p>
            </div>

            <div class="col-md-4 text-md-end mt-4 mt-md-0">
                <h2 class="text-primary fw-bold">$@Model.Price</h2>
                <p class="text-muted">for @Model.Duration days</p>
            </div>
        </div>

        <hr class="my-4" />

        <div class="row g-4">
            <div class="col-md-4">
                <div class="info-box text-center">
                    <h6 class="text-muted">Price</h6>
                    <h4 class="fw-bold">$@Model.Price</h4>
                </div>
            </div>

            <div class="col-md-4">
                <div class="info-box text-center">
                    <h6 class="text-muted">Duration</h6>
                    <h4 class="fw-bold">@Model.Duration Days</h4>
                </div>
            </div>

            <div class="col-md-4">
                <div class="info-box text-center">
                    <h6 class="text-muted">Category</h6>
                    <h4 class="fw-bold">@Model.Category?.Name</h4>
                </div>
            </div>
        </div>

        <div class="mt-5">
            <h4 class="fw-bold mb-3">About this service</h4>
            <p class="text-muted">
                @Model.Description
            </p>
        </div>

        <div class="mt-4">
            <h4 class="fw-bold mb-3">Service Features</h4>

            <div class="row">
                <div class="col-md-6 mb-2">✔ Easy subscription management</div>
                <div class="col-md-6 mb-2">✔ Track renewal dates</div>
                <div class="col-md-6 mb-2">✔ Simple monthly pricing</div>
                <div class="col-md-6 mb-2">✔ Available in your dashboard</div>
            </div>
        </div>

        <div class="mt-5 d-flex gap-3 flex-wrap">
            <button type="button"
                    class="btn btn-primary btn-lg"
                    data-bs-toggle="modal"
                    data-bs-target="#subscribeModal">
                Subscribe Now
            </button>

            <a asp-area="User"
               asp-controller="Service"
               asp-action="Index"
               class="btn btn-outline-primary btn-lg">
                Back to Services
            </a>
        </div>

    </div>
</div>

<div class="modal fade" id="subscribeModal" tabindex="-1" aria-labelledby="subscribeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4">

            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="subscribeModalLabel">
                    Confirm Subscription
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>
            </div>

            <form asp-area="User"
                  asp-controller="Subscription"
                  asp-action="Subscribe"
                  method="post">

                <div class="modal-body">
                    <input type="hidden"
                           name="serviceId"
                           value="@Model.ServiceID" />

                    <p class="text-muted">
                        Are you sure you want to subscribe to this service?
                    </p>

                    <div class="info-box mb-3">
                        <strong>Service:</strong> @Model.Name
                    </div>

                    <div class="info-box mb-3">
                        <strong>Price:</strong> $@Model.Price
                    </div>

                    <div class="info-box">
                        <strong>Duration:</strong> @Model.Duration days
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-light"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit"
                            class="btn btn-primary">
                        Confirm Subscription
                    </button>
                </div>

            </form>

        </div>
    </div>
</div>