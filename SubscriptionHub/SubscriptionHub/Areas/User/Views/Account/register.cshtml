﻿@{
ViewData["Title"] = "Register";
}
@model RegisterRequest
<style>
    body {
        background: #f7f4ff;
    }

    .register-wrapper {
        min-height: 75vh;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 40px 15px;
    }

    .register-card {
        width: 100%;
        max-width: 550px;
        background: white;
        border-radius: 26px;
        padding: 45px;
        box-shadow: 0 14px 35px rgba(98, 80, 200, 0.14);
        border: 1px solid #e6ddff;
    }
</style>

<section class="register-wrapper">
    <div class="register-card">

        <h2 class="fw-bold text-center mb-2">Create Account</h2>

        <p class="text-muted text-center mb-4">
            Join SubscriptionHub and start managing your subscriptions
        </p>

        <form asp-area="User" asp-controller="Account" asp-action="Register" method="post">

            <div class="mb-3">
                <label class="form-label">First Name</label>
                <input type="text"
                      asp-for ="FirstName"           
                       class="form-control form-control-lg"
                       placeholder="Enter your first name"
                       required />
            </div>

            <div class="mb-3">
                <label class="form-label">Last Name</label>
                <input type="text"
                       asp-for="LastName"
                       class="form-control form-control-lg"
                       placeholder="Enter your last name"
                       required />
            </div>

            <div class="mb-3">
                <label class="form-label">Email Address</label>
                <input type="email"
                       asp-for="Email"
                       class="form-control form-control-lg"
                       placeholder="Enter your email"
                       required />
            </div>

            <div class="mb-3">
                <label class="form-label">Password</label>
                <input type="password"
                       asp-for="Password"
                       class="form-control form-control-lg"
                       placeholder="Create a password"
                       required />
            </div>

            <div class="mb-3">
                <label class="form-label">Confirm Password</label>
                <input type="password"
                       asp-for="ConfirmPassword"
                       class="form-control form-control-lg"
                       placeholder="Confirm your password"
                       required />
            </div>

            <button type="submit"
                    class="btn btn-primary btn-lg w-100 mt-3">
                Create Account
            </button>

        </form>

        <p class="text-center mt-4 mb-0">
            Already have an account?
            <a asp-area="User"
               asp-controller="Account"
               asp-action="Login">
                Login
            </a>
        </p>

    </div>
</section>