﻿
@model SubscriptionHub.Models.User

@{
    ViewData["Title"] = "Profile";
}

<style>
    body {
        background: #f7f4ff;
    }

    .settings-header {
        text-align: center;
    }

    .settings-card {
        background: #ffffff;
        border-radius: 24px;
        border: 1px solid #e6ddff;
        box-shadow: 0 12px 30px rgba(98, 80, 200, 0.10);
    }
</style>

<section class="settings-page my-5">
    <div class="container">

        <div class="settings-header mb-4">
            <h2 class="fw-bold mb-1">My Profile</h2>
            <p class="text-muted">Manage your personal information and account preferences</p>
        </div>

        <div class="settings-card p-4 mb-4">
            <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
                <h5 class="fw-bold mb-0">👤 Personal Information</h5>

                <button type="button"
                        class="btn btn-outline-primary"
                        data-bs-toggle="modal"
                        data-bs-target="#editProfileModal">
                    Edit Information
                </button>
            </div>

            <div class="row text-center">
                <div class="col-md-3 mb-3">
                    <small class="text-muted">First Name</small>
                    <p class="fw-semibold mb-0">@Model.FirstName</p>
                </div>

                <div class="col-md-3 mb-3">
                    <small class="text-muted">Last Name</small>
                    <p class="fw-semibold mb-0">@Model.LastName</p>
                </div>

                <div class="col-md-3 mb-3">
                    <small class="text-muted">Email Address</small>
                    <p class="fw-semibold mb-0">@Model.Email</p>
                </div>

                <div class="col-md-3 mb-3">
                    <small class="text-muted">Account Type</small>
                    <p class="fw-semibold mb-0">
                        @(Model.isAdmin ? "Admin" : "User")
                    </p>
                </div>
            </div>
        </div>

        <div class="row g-4">

            <div class="col-md-6">
                <div class="settings-card p-4 h-100">
                    <h5 class="fw-bold mb-3">🔒 Security</h5>

                    <p class="text-muted mb-3">Password: ********</p>

                    <button type="button"
                            class="btn btn-outline-primary"
                            data-bs-toggle="modal"
                            data-bs-target="#changePasswordModal">
                        Change Password
                    </button>
                </div>
            </div>

            <div class="col-md-6">
                <div class="settings-card p-4 h-100">
                    <h5 class="fw-bold mb-3">🌐 Language</h5>

                    <label class="form-label text-muted">Choose application language</label>
                    <select class="form-select">
                        <option selected>English</option>
                        <option>Arabic</option>
                    </select>
                </div>
            </div>

            <div class="col-md-6">
                <div class="settings-card p-4 h-100">
                    <h5 class="fw-bold mb-3">🌙 Appearance</h5>

                    <p class="text-muted">Choose your preferred theme</p>

                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-primary">
                            ☀ Light Mode
                        </button>

                        <button type="button" class="btn btn-outline-secondary">
                            🌙 Dark Mode
                        </button>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="settings-card p-4 h-100">
                    <h5 class="fw-bold mb-3">⚠️ Account Management</h5>

                    <p class="text-muted">
                        You can delete your account if you no longer want to use SubscriptionHub.
                    </p>

                    <button  class="btn btn-outline-danger">
                        Delete Account
                    </button>
                </div>
            </div>

        </div>
    </div>
</section>

<div class="modal fade" id="editProfileModal" tabindex="-1" aria-labelledby="editProfileModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4">

            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="editProfileModalLabel">
                    Edit Personal Information
                </h5>

                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <form asp-area="User" asp-controller="Account" asp-action="UpdateProfile" method="post">

                <div class="modal-body">

                    <input type="hidden" name="UserID" value="@Model.UserID" />

                    <div class="mb-3">
                        <label class="form-label">First Name</label>
                        <input type="text"
                               name="FirstName"
                               value="@Model.FirstName"
                               class="form-control"
                               placeholder="Enter first name"
                               required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Last Name</label>
                        <input type="text"
                               name="LastName"
                               value="@Model.LastName"
                               class="form-control"
                               placeholder="Enter last name"
                               required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Email Address</label>
                        <input type="email"
                               name="Email"
                               value="@Model.Email"
                               class="form-control"
                               placeholder="Enter email address"
                               required />
                    </div>

                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-light"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit"
                            class="btn btn-primary">
                        Save Changes
                    </button>
                </div>

            </form>

        </div>
    </div>
</div>

<div class="modal fade" id="changePasswordModal" tabindex="-1" aria-labelledby="changePasswordModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4">

            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="changePasswordModalLabel">
                    Change Password
                </h5>

                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <form asp-area="User" asp-controller="Account" asp-action="ChangePassword" method="post">

                <div class="modal-body">

                    <input type="hidden" name="UserID" value="@Model.UserID" />

                    <div class="mb-3">
                        <label class="form-label">Current Password</label>
                        <input type="password"
                               name="CurrentPassword"
                               class="form-control"
                               placeholder="Enter current password"
                               required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">New Password</label>
                        <input type="password"
                               name="NewPassword"
                               class="form-control"
                               placeholder="Enter new password"
                               required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Confirm New Password</label>
                        <input type="password"
                               name="ConfirmPassword"
                               class="form-control"
                               placeholder="Confirm new password"
                               required />
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-light"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit"
                            class="btn btn-primary">
                        Save Changes
                    </button>
                </div>

            </form>

        </div>
    </div>
</div>