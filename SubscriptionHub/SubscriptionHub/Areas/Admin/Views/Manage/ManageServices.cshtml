@model IEnumerable<SubscriptionHub.Models.Service>
@using SubscriptionHub.Models

@{
    ViewData["Title"] = "Manage Services";

    var categories = ViewBag.Categories as List<Category> ?? new List<Category>();
    var selectedCategoryName = ViewBag.SelectedCategoryName as string;
}

<style>
    body {
        background: #f7f4ff;
    }

    .service-card, .top-card {
        background: white;
        border-radius: 24px;
        border: 1px solid #e6ddff;
        box-shadow: 0 12px 30px rgba(98, 80, 200, 0.10);
        transition: 0.3s;
    }

        .service-card:hover {
            transform: translateY(-5px);
        }

    .action-btn {
        border-radius: 12px;
    }

    .price-text {
        color: #6f42c1;
        font-weight: 800;
        font-size: 22px;
    }
</style>

<div class="container py-5">

    <h2 class="fw-bold text-center mb-2">
        Manage Services
    </h2>

    <p class="text-center text-muted mb-5">
        @(string.IsNullOrEmpty(selectedCategoryName)
            ? "Add, edit, and delete subscription services"
            : $"Services in {selectedCategoryName}")
    </p>

    <div class="top-card p-4 mb-5 d-flex justify-content-between align-items-center">
        <div>
            <h5 class="fw-bold mb-1">Services</h5>
            <p class="text-muted mb-0">
                Manage service prices and categories
            </p>
        </div>

        <button class="btn btn-primary action-btn"
                data-bs-toggle="modal"
                data-bs-target="#addServiceModal">
            Add Service
        </button>
    </div>

    <div class="row">

        @if (Model != null && Model.Any())
        {
            foreach (var service in Model)
            {
                <div class="col-md-4 mb-4">
                    <div class="service-card p-4 h-100">

                        <h5 class="fw-bold">
                            @service.Name
                        </h5>

                        <p class="text-muted">
                            @service.Description
                        </p>

                        <p class="price-text">
                            $@service.Price
                        </p>

                        <p class="text-muted mb-2">
                            Duration: @service.Duration days
                        </p>

                        <p class="text-muted mb-4">
                            Category:
                            <span class="fw-bold">
                                @(service.Category != null ? service.Category.Name : "No Category")
                            </span>
                        </p>

                        <div class="d-flex gap-2">

                            <button class="btn btn-outline-primary w-50 action-btn"
                                    data-bs-toggle="modal"
                                    data-bs-target="#editServiceModal-@service.ServiceID">
                                Edit Price
                            </button>

                            <a asp-area="Admin"
                               asp-controller="Manage"
                               asp-action="DeleteService"
                               asp-route-id="@service.ServiceID"
                               class="btn btn-outline-danger w-50 action-btn">
                                Delete
                            </a>

                        </div>

                    </div>
                </div>

                <div class="modal fade"
                     id="editServiceModal-@service.ServiceID"
                     tabindex="-1"
                     aria-hidden="true">

                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content"
                             style="border-radius: 24px; border: 1px solid #e6ddff;">

                            <form asp-area="Admin"
                                  asp-controller="Manage"
                                  asp-action="EditServicePrice"
                                  method="post">

                                <div class="modal-header">
                                    <h5 class="modal-title fw-bold">
                                        Edit Service Price
                                    </h5>

                                    <button type="button"
                                            class="btn-close"
                                            data-bs-dismiss="modal">
                                    </button>
                                </div>

                                <div class="modal-body">

                                    <input type="hidden"
                                           name="ServiceID"
                                           value="@service.ServiceID" />

                                    <div class="mb-3">
                                        <label class="form-label">Service Name</label>
                                        <input type="text"
                                               class="form-control"
                                               value="@service.Name"
                                               readonly />
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label">New Price</label>
                                        <input type="number"
                                               name="Price"
                                               value="@service.Price"
                                               class="form-control"
                                               step="0.01"
                                               required />
                                    </div>

                                </div>

                                <div class="modal-footer">
                                    <button type="button"
                                            class="btn btn-outline-secondary action-btn"
                                            data-bs-dismiss="modal">
                                        Cancel
                                    </button>

                                    <button type="submit"
                                            class="btn btn-primary action-btn">
                                        Save Changes
                                    </button>
                                </div>

                            </form>

                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="text-center">
                <p class="text-muted">
                    No services found.
                </p>
            </div>
        }

    </div>

</div>

<div class="modal fade"
     id="addServiceModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content"
             style="border-radius: 24px; border: 1px solid #e6ddff;">

            <form asp-area="Admin"
                  asp-controller="Manage"
                  asp-action="AddService"
                  method="post">

                <div class="modal-header">
                    <h5 class="modal-title fw-bold">
                        Add New Service
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal">
                    </button>
                </div>

                <div class="modal-body">

                    <div class="mb-3">
                        <label class="form-label">Service Name</label>
                        <input type="text"
                               name="Name"
                               class="form-control"
                               placeholder="Enter service name"
                               required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Description</label>
                        <textarea name="Description"
                                  class="form-control"
                                  rows="3"
                                  placeholder="Enter service description"
                                  required></textarea>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Price</label>
                        <input type="number"
                               name="Price"
                               class="form-control"
                               step="0.01"
                               required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Duration (days)</label>
                        <input type="number"
                               name="Duration"
                               class="form-control"
                               required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Category</label>

                        <select name="CategoryID"
                                class="form-select"
                                required>

                            <option value="">Choose category...</option>

                            @foreach (var category in categories)
                            {
                                <option value="@category.CategoryID">
                                    @category.Name
                                </option>
                            }

                        </select>
                    </div>

                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-outline-secondary action-btn"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit"
                            class="btn btn-primary action-btn">
                        Add Service
                    </button>
                </div>

            </form>

        </div>
    </div>
</div>