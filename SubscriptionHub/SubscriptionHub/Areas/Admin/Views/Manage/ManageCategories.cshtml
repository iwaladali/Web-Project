@model IEnumerable<SubscriptionHub.Models.Category>

@{
    ViewData["Title"] = "Manage Categories";
}

<style>
    body {
        background: #f7f4ff;
    }

    .category-card {
        background: white;
        border-radius: 24px;
        border: 1px solid #e6ddff;
        box-shadow: 0 12px 30px rgba(98, 80, 200, 0.10);
        transition: 0.3s;
        cursor: pointer;
    }

        .category-card:hover {
            transform: translateY(-5px);
        }

    .top-card {
        background: white;
        border-radius: 24px;
        border: 1px solid #e6ddff;
        box-shadow: 0 12px 30px rgba(98, 80, 200, 0.10);
    }

    .action-btn {
        border-radius: 12px;
    }

    .category-link {
        text-decoration: none;
        color: inherit;
    }
</style>

<div class="container py-5">

    <h2 class="fw-bold text-center mb-2">
        Manage Categories
    </h2>

    <p class="text-center text-muted mb-5">
        Add categories and view services by category
    </p>

    <div class="top-card p-4 mb-5 d-flex justify-content-between align-items-center">
        <div>
            <h5 class="fw-bold mb-1">Categories</h5>
            <p class="text-muted mb-0">
                Click a category to view its services
            </p>
        </div>

        <button class="btn btn-primary action-btn"
                data-bs-toggle="modal"
                data-bs-target="#addCategoryModal">
            Add Category
        </button>
    </div>

    <div class="row">

        @if (Model != null && Model.Any())
        {
            foreach (var category in Model)
            {
                <div class="col-md-4 mb-4">

                    <div class="category-card p-4 h-100">

                        <a asp-area="Admin"
                           asp-controller="Manage"
                           asp-action="ManageServices"
                           asp-route-categoryId="@category.CategoryID"
                           class="category-link">

                            <h5 class="fw-bold mb-3">
                                @category.Name
                            </h5>

                            <p class="text-muted mb-4">
                                View and manage services in this category
                            </p>

                        </a>

                        <a asp-area="Admin"
                           asp-controller="Manage"
                           asp-action="DeleteCategory"
                           asp-route-id="@category.CategoryID"
                           class="btn btn-outline-danger w-100 action-btn">
                            Delete Category
                        </a>

                    </div>

                </div>
            }
        }
        else
        {
            <div class="text-center">
                <p class="text-muted">
                    No categories found.
                </p>
            </div>
        }

    </div>

</div>

<div class="modal fade"
     id="addCategoryModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content"
             style="border-radius: 24px; border: 1px solid #e6ddff;">

            <form asp-area="Admin"
                  asp-controller="Manage"
                  asp-action="AddCategory"
                  method="post">

                <div class="modal-header">
                    <h5 class="modal-title fw-bold">
                        Add New Category
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal">
                    </button>
                </div>

                <div class="modal-body">

                    <div class="mb-3">
                        <label class="form-label">
                            Category Name
                        </label>

                        <input type="text"
                               name="Name"
                               class="form-control"
                               placeholder="Enter category name"
                               required />
                    </div>

                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-outline-secondary action-btn"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit"
                            class="btn btn-primary action-btn">
                        Add Category
                    </button>
                </div>

            </form>

        </div>
    </div>
</div>