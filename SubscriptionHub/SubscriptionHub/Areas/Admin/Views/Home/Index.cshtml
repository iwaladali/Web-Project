@{
    ViewData["Title"] = "Admin Dashboard";
}

<style>
    body {
        background: #f7f4ff;
    }

    .dashboard-card {
        background: white;
        border-radius: 24px;
        border: 1px solid #e6ddff;
        box-shadow: 0 12px 30px rgba(98, 80, 200, 0.10);
        transition: 0.3s;
    }

        .dashboard-card:hover {
            transform: translateY(-5px);
        }

    .stat-number {
        font-size: 34px;
        font-weight: bold;
        color: #6f42c1;
    }

    .action-btn {
        border-radius: 14px;
        padding: 12px;
    }
</style>

<div class="container py-5">

   
    <h2 class="fw-bold text-center mb-2">
        Admin Dashboard
    </h2>

    <p class="text-center text-muted mb-5">
        Manage users, services, categories and subscriptions
    </p>

    <div class="row mb-5">

        <div class="col-md-3 mb-4">
            <div class="dashboard-card p-4 text-center">
                <div class="stat-number">
                    @ViewBag.UsersCount
                </div>
                <p class="text-muted mb-0">
                    Total Users
                </p>
            </div>
        </div>

        <div class="col-md-3 mb-4">
            <div class="dashboard-card p-4 text-center">
                <div class="stat-number">
                    @ViewBag.ServicesCount
                </div>
                <p class="text-muted mb-0">
                    Total Services
                </p>
            </div>
        </div>

        <div class="col-md-3 mb-4">
            <div class="dashboard-card p-4 text-center">
                <div class="stat-number">
                    @ViewBag.CategoriesCount
                </div>
                <p class="text-muted mb-0">
                    Categories
                </p>
            </div>
        </div>

        <div class="col-md-3 mb-4">
            <div class="dashboard-card p-4 text-center">
                <div class="stat-number">
                    @ViewBag.SubscriptionsCount
                </div>
                <p class="text-muted mb-0">
                    Subscriptions
                </p>
            </div>
        </div>

    </div>

    <div class="dashboard-card p-4">

        <h4 class="fw-bold mb-4">
            Quick Actions
        </h4>

        <div class="row">

            <div class="col-md-3 mb-3">
                <a asp-controller="Manage"
                   asp-action="ManageUsers"
                   class="btn btn-primary w-100 action-btn">
                    Manage Users
                </a>
            </div>

            <div class="col-md-3 mb-3">
                <a asp-controller="Manage"
                   asp-action="ManageServices"
                   class="btn btn-outline-primary w-100 action-btn">
                    Manage Services
                </a>
            </div>

            <div class="col-md-3 mb-3">
                <a asp-controller="Manage"
                   asp-action="ManageCategories"
                   class="btn btn-outline-primary w-100 action-btn">
                    Manage Categories
                </a>
            </div>

            <div class="col-md-3 mb-3">
                <a asp-controller="Manage"
                   asp-action="ManageSubscriptions"
                   class="btn btn-outline-primary w-100 action-btn">
                    Manage Subscriptions
                </a>
            </div>

        </div>

    </div>
    

</div>

