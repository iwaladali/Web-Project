@{
    ViewData["Title"] = "Login";
}
<style>
    body {
        background: #f7f4ff;
    }

    .login-wrapper {
        min-height: 75vh;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 40px 15px;
    }

    .login-card {
        width: 100%;
        max-width: 480px;
        background: white;
        border-radius: 26px;
        padding: 45px;
        box-shadow: 0 14px 35px rgba(98, 80, 200, 0.14);
        border: 1px solid #e6ddff;
    }
</style>


<section class="login-wrapper">
    <div class="login-card">
        <h2 class="fw-bold text-center mb-2">Welcome Back</h2>
        <p class="text-muted text-center mb-4">
            Login to manage your subscriptions
        </p>

        <form asp-area="User" asp-controller="Account" asp-action="Login" method="post">
            <div class="mb-3">
                <label class="form-label">Email Address</label>
                <input type="email" name="Email" class="form-control form-control-lg"
                       placeholder="Enter your email" required />
            </div>

            <div class="mb-3">
                <label class="form-label">Password</label>
                <input type="password" name="Password" class="form-control form-control-lg"
                       placeholder="Enter your password" required />
            </div>

            <button type="submit" class="btn btn-primary btn-lg w-100 mt-3">
                Login
            </button>
        </form>

        <p class="text-center mt-4 mb-0">
            Don't have an account?
            <a asp-area="User" asp-controller="Account" asp-action="Register">
                Create Account
            </a>
        </p>
    </div>
</section>

